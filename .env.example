# Cece Barber — ortam değişkenleri örneği
# Gerçek değerleri .env (yerel) veya Vercel > Settings > Environment Variables içine koyun.
# Bu dosya örnektir; içine GERÇEK anahtar yazmayın.

# Supabase proje URL'i (public)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# service_role (secret) anahtar — YALNIZ sunucuda kullanılır, tarayıcıya ASLA gitmez.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# anon (public) anahtar — tarayıcıda Supabase Auth girişi için; herkese açık olması normaldir.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx
